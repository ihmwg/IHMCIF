###########################################
## DEPOSITION RULES EXTENSION DICTIONARY ##
###########################################

data_mmcif_pdbx_deposition_rules_ext.dic

loop_
_item_type_list.code
_item_type_list.primitive_code
_item_type_list.construct
_item_type_list.detail
               value_csv        char
               '[^ \t\n,]+((, ?| )[^ \t\n,]+)*'
               'value or comma-separated list of values; single spaces are allowed inside a value and after a comma; no tabs, newlines, spaces before a comma, or empty entries'
               pdb_id_u         uchar
               '([1-9][A-Za-z0-9]{3}|[Pp][Dd][Bb]_[A-Za-z0-9]{8})'
               'PDB code (case insensitive)'
               emd_id           char
               'EMD-[0-9]{4,}'
               'EMDB code'
               pdb_id_dep       char
               '([1-9][A-Za-z0-9]{3}|pdb_0000[1-9][a-z0-9]{3}|pdb_[1-9a-z][a-z0-9]{7})'
               'PDB code accepted at deposition: 4-character code (case insensitive), pdb_0000 followed by a 4-character code, or pdb_ followed by 8 lowercase alphanumeric characters not starting with 0'
               deposition_id    char
               'D_1[0-9]{9}'
               'OneDep deposition identifier, e.g. D_1000123456'
               item_name_csv    char
               '_[_A-Za-z0-9]+\.[][_A-Za-z0-9%-]+(,_[_A-Za-z0-9]+\.[][_A-Za-z0-9%-]+)*'
               'comma-separated list of full item names, without spaces'


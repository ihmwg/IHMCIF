     is evaluated separately for each row of this category remaining
     after row selection (PDBX_DEPOSITION_RULE_ROW_SELECTION); every
     such row must satisfy the rule, and each failing row is reported
     as a separate violation.
;
  _item.name               '_pdbx_deposition_rule.scope_category'
  _item.category_id        pdbx_deposition_rule
  _item.mandatory_code     yes
  _item_type.code          code
   save_


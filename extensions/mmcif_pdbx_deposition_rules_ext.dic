  _item.mandatory_code     no
  _item_type.code          ucode
  _item_default.value      NO
  loop_
  _item_enumeration.value
    YES
    NO
   save_

save__pdbx_deposition_rule.row_selection_flag
    _item_description.description
;    Flag indicating that the rule is evaluated on selected rows of one
     or more categories, as defined in
     PDBX_DEPOSITION_RULE_ROW_SELECTION. If NO, all rows of every
     category referenced by the rule are evaluated.
;
